{# Page layout for biershop_thema. #}
<header role="banner">
  {{ page.header }}

  {% if page.primary_menu or page.secondary_menu %}
    <nav class="navbar navbar-expand-lg" aria-label="Hoofdnavigatie">
      <div class="container d-flex align-items-center">
        {% if page.primary_menu %}
          <div class="region-primary-menu">
            {{ page.primary_menu }}
          </div>
        {% endif %}
        {% if page.secondary_menu %}
          <div class="region-secondary-menu">
            {{ page.secondary_menu }}
          </div>
        {% endif %}
      </div>
    </nav>
  {% endif %}
</header>

<main role="main">
  <a id="main-content" tabindex="-1"></a>
  <div class="container">
    {% if page.breadcrumb %}
      {{ page.breadcrumb }}
    {% endif %}
    <div class="row">
      {% if page.sidebar_first %}
        <aside class="col-12 col-lg-3 order-2 order-lg-1">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}
      <div class="col-12{% if page.sidebar_first %} col-lg-9{% endif %} order-1 order-lg-2">
        {{ page.content }}
      </div>
      {% if page.sidebar_second %}
        <aside class="col-12 col-lg-3 order-3">
          {{ page.sidebar_second }}
        </aside>
      {% endif %}
    </div>
  </div>
</main>

{% if page.footer %}
  <footer role="contentinfo" class="mt-auto">
    <div class="container">
      {{ page.footer }}
    </div>
  </footer>
{% endif %}
